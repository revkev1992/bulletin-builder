{
  "name": "bulletin-builder",
  "productName": "Bulletin Builder",
  "version": "0.4.1",
  "description": "Weekly worship bulletin layout tool for Highland UMC (Publisher replacement).",
  "main": "src/main.js",
  "author": "Highland UMC",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "export-pdf": "electron . --export-pdf",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "org.highlandumc.bulletinbuilder",
    "productName": "Bulletin Builder",
    "files": [
      "src/**/*",
      "package.json",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Bulletin-Builder-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "Bulletin Builder",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "fileAssociations": [
      {
        "ext": "bulletin",
        "name": "Bulletin",
        "description": "Bulletin Builder week",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "revkev1992",
        "repo": "bulletin-builder",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/revkev1992/bulletin-builder.git"
  }
}
